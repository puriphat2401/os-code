#include <iostream>
#include <list>
#include <unordered_map>
#include <iomanip>
using namespace std;

const int TLB_SIZE = 8;

class TLB {
private:
    struct TLBEntry {
        int pageNumber;
        int frameNumber;
        TLBEntry(int p, int f) : pageNumber(p), frameNumber(f) {}
    };

    list<TLBEntry> tlbCache; // MRU อยู่หน้าสุด
    unordered_map<int, list<TLBEntry>::iterator> tlbMap;
    int hits;
    int misses;

public:
    TLB() : hits(0), misses(0) {}

    int lookup(int pageNumber) {
        auto it = tlbMap.find(pageNumber);
        if (it != tlbMap.end()) {
            hits++;
            int frame = it->second->frameNumber;

            // ย้ายไปหน้า list (LRU)
            tlbCache.splice(tlbCache.begin(), tlbCache, it->second);

            cout << "TLB HIT : Page " << pageNumber
                 << " -> Frame " << frame << endl;
            return frame;
        } else {
            misses++;
            cout << "TLB MISS: Page " << pageNumber << endl;
            return -1;
        }
    }

    void insert(int pageNumber, int frameNumber) {
        // ถ้ามีอยู่แล้ว
        auto it = tlbMap.find(pageNumber);
        if (it != tlbMap.end()) {
            it->second->frameNumber = frameNumber;
            tlbCache.splice(tlbCache.begin(), tlbCache, it->second);
            return;
        }

        // ถ้า TLB เต็ม → ลบ LRU
        if (tlbCache.size() >= TLB_SIZE) {
            int removedPage = tlbCache.back().pageNumber;
            cout << "TLB FULL: Remove Page " << removedPage << endl;
            tlbMap.erase(removedPage);
            tlbCache.pop_back();
        }

        // เพิ่ม entry ใหม่
        tlbCache.push_front(TLBEntry(pageNumber, frameNumber));
        tlbMap[pageNumber] = tlbCache.begin();

        cout << "TLB INSERT: Page " << pageNumber
             << " -> Frame " << frameNumber << endl;
    }

    void displayTLB() {
        cout << "\n=== TLB CONTENTS (MRU → LRU) ===\n";
        cout << setw(10) << "Page"
             << setw(10) << "Frame" << endl;
        cout << string(20, '-') << endl;

        for (auto &e : tlbCache) {
            cout << setw(10) << e.pageNumber
                 << setw(10) << e.frameNumber << endl;
        }
    }

    void displayStats() {
        int total = hits + misses;
        double hitRatio = (total > 0) ? (double)hits / total * 100 : 0;

        cout << "\n=== TLB STATISTICS ===\n";
        cout << "Accesses : " << total << endl;
        cout << "Hits     : " << hits << endl;
        cout << "Misses   : " << misses << endl;
        cout << fixed << setprecision(2);
        cout << "Hit Rate : " << hitRatio << "%\n";
    }
};

// ---------------- MEMORY SYSTEM ----------------

class MemorySystem {
private:
    TLB tlb;
    unordered_map<int, int> pageTable;

public:
    MemorySystem() {
        pageTable[0] = 5;
        pageTable[1] = 2;
        pageTable[2] = 8;
        pageTable[3] = 1;
        pageTable[4] = 9;
        pageTable[5] = 3;
        pageTable[6] = 7;
        pageTable[7] = 4;
    }

    void translate(int pageNumber) {
        cout << "\n--- Access Page " << pageNumber << " ---\n";

        int frame = tlb.lookup(pageNumber);
        if (frame == -1) {
            auto it = pageTable.find(pageNumber);
            if (it != pageTable.end()) {
                frame = it->second;
                cout << "Page Table: Page " << pageNumber
                     << " -> Frame " << frame << endl;
                tlb.insert(pageNumber, frame);
            } else {
                cout << "PAGE FAULT!\n";
            }
        }
    }

    void display() {
        tlb.displayTLB();
        tlb.displayStats();
    }
};

// ---------------- MAIN ----------------

int main() {
    cout << "TLB SIMULATION (LRU)\n";
    cout << "===================\n";
    cout << "TLB Size = " << TLB_SIZE << endl << endl;

    MemorySystem mem;

    int referenceString[] = {0,1,2,3,0,1,4,0,1,2,3,5,6,7,0,1};
    int n = sizeof(referenceString) / sizeof(referenceString[0]);

    cout << "Reference String: ";
    for (int i = 0; i < n; i++)
        cout << referenceString[i] << " ";
    cout << "\n";

    for (int i = 0; i < n; i++)
        mem.translate(referenceString[i]);

    mem.display();
    return 0;
}

