ADDITIONAL EXAMPLE: COMPLETE ADDRESS TRANSLATION DEMO

#include &lt;iostream&gt;
#include &lt;iomanip&gt;
#include &lt;bitset&gt;
using namespace std;
void demonstrateAddressTranslation() {
cout &lt;&lt; &quot;========== ADDRESS TRANSLATION DEMONSTRATION ==========&quot; &lt;&lt; endl;
cout &lt;&lt; &quot;\nScenario:&quot; &lt;&lt; endl;
cout &lt;&lt; &quot;- 32-bit virtual address space&quot; &lt;&lt; endl;
cout &lt;&lt; &quot;- 4 KB (4096 bytes) page size&quot; &lt;&lt; endl;
cout &lt;&lt; &quot;- 28-bit physical address space&quot; &lt;&lt; endl;
const int PAGE_SIZE = 4096;
const int OFFSET_BITS = 12; // log2(4096)
const int VA_PAGE_BITS = 20; // 32 - 12
const int PA_FRAME_BITS = 16; // 28 - 12
// Sample page table (simplified)
int pageTable[10] = {5, 2, 8, 1, 9, 3, 7, 4, 6, 0};
// Sample virtual address: 8196 (0x2004)
unsigned int virtualAddr = 8196;
cout &lt;&lt; &quot;\n=== Translating Virtual Address: &quot; &lt;&lt; virtualAddr &lt;&lt; &quot; ===&quot; &lt;&lt; endl;
cout &lt;&lt; &quot;Binary: &quot; &lt;&lt; bitset&lt;32&gt;(virtualAddr) &lt;&lt; endl;
// Extract page number and offset
unsigned int pageNumber = virtualAddr &gt;&gt; OFFSET_BITS;
unsigned int offset = virtualAddr &amp; ((1 &lt;&lt; OFFSET_BITS) - 1);
cout &lt;&lt; &quot;\nExtraction:&quot; &lt;&lt; endl;
cout &lt;&lt; &quot; Page Number: &quot; &lt;&lt; pageNumber &lt;&lt; &quot; (bits 31-12)&quot; &lt;&lt; endl;
cout &lt;&lt; &quot; Offset: &quot; &lt;&lt; offset &lt;&lt; &quot; (bits 11-0)&quot; &lt;&lt; endl;
// Look up frame number
if (pageNumber &lt; 10) {
unsigned int frameNumber = pageTable[pageNumber];
cout &lt;&lt; &quot;\nPage Table Lookup:&quot; &lt;&lt; endl;
cout &lt;&lt; &quot; Page &quot; &lt;&lt; pageNumber &lt;&lt; &quot; -&gt; Frame &quot; &lt;&lt; frameNumber &lt;&lt; endl;
// Calculate physical address
unsigned int physicalAddr = (frameNumber &lt;&lt; OFFSET_BITS) | offset;
cout &lt;&lt; &quot;\nPhysical Address Calculation:&quot; &lt;&lt; endl;
cout &lt;&lt; &quot; Frame Number: &quot; &lt;&lt; frameNumber &lt;&lt; endl;
cout &lt;&lt; &quot; Offset: &quot; &lt;&lt; offset &lt;&lt; endl;
cout &lt;&lt; &quot; Physical Address: &quot; &lt;&lt; physicalAddr &lt;&lt; endl;
cout &lt;&lt; &quot; Binary: &quot; &lt;&lt; bitset&lt;28&gt;(physicalAddr) &lt;&lt; endl;
// Verification
cout &lt;&lt; &quot;\nVerification:&quot; &lt;&lt; endl;
cout &lt;&lt; &quot; Frame &quot; &lt;&lt; frameNumber &lt;&lt; &quot; starts at: &quot;
&lt;&lt; (frameNumber * PAGE_SIZE) &lt;&lt; endl;
cout &lt;&lt; &quot; Add offset &quot; &lt;&lt; offset &lt;&lt; endl;
cout &lt;&lt; &quot; Result: &quot; &lt;&lt; physicalAddr &lt;&lt; endl;
}
}

int main() {
demonstrateAddressTranslation();
return 0;
}
